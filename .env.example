# OpenAI API key, used for AI-generated session topic titles (tried first)
# Get one at: https://platform.openai.com/api-keys
OPENAI_APIKEY=sk-XXXXXXXXXXXXXXXXXXXXXXX

# GitHub Personal Access Token, used as a fallback for AI topic generation
# (via GitHub Models) if OPENAI_APIKEY is missing or fails. Optional.
# Get one at: https://github.com/settings/tokens
GITHUB_TOKEN=github_pat_XXXXXXXXXXXXXXXXXXXXXXX

PANOPTO_SERVER=your-tenant.cloud.panopto.eu
PANOPTO_CLIENT_ID=XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
PANOPTO_CLIENT_SECRET=XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
TOKEN_FILE=auth/panopto_tokens.json
OUTPUT_DIR=rename_output
SCHEDULE_FILE=Eve-Sat 25-26  Weekly Schedule.xlsx

# Set to DEBUG to write backup/results/moodle-metadata files to OUTPUT_DIR
# during renames. Left unset (INFO), these files are skipped.
LOGGING_LEVEL=INFO

MOODLE_URL=https://your-moodle-site.example.com
MOODLE_USERNAME=XXXXXXXX
MOODLE_PASSWORD=XXXXXXX
MOODLE_API_KEY=XXXXXXXXXXXXXXXX

EMAIL_FROM=XXXXXXXX
EMAIL_PASSWORD=XXXXXXX
EMAIL_TO=XXXXXXXX,XXXXXXXX